{
  "name": "omnifocus-mcp-enhanced",
  "type": "module",
  "version": "1.21.0",
  "description": "Enhanced MCP server with 29 consolidated tools: unified task reads, folder/tag management, batch operations, project shaping, and comprehensive task management",
  "main": "dist/server.js",
  "bin": {
    "omnifocus-mcp-enhanced": "cli.cjs"
  },
  "files": [
    "dist/",
    "cli.cjs",
    "skills/omnifocus-cli/",
    "README.md",
    "README.zh.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "npm run clean && npm run typecheck && tsc --noCheck && npm run copy-files && npm run prune-dist && chmod 755 dist/server.js",
    "build:test": "npm run clean && npm run typecheck && tsc --noCheck && npm run copy-files && chmod 755 dist/server.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "copy-files": "node scripts/copy-files.mjs",
    "prune-dist": "node scripts/prune-dist.mjs",
    "start": "node dist/server.js",
    "dev": "tsc -w",
    "prepublishOnly": "npm run build",
    "test": "npm run build:test && node --test dist/*.test.js dist/context/*.test.js dist/tools/definitions/*.test.js dist/tools/*.test.js dist/tools/primitives/*.test.js dist/utils/*.test.js scripts/*.test.mjs",
    "benchmark:smoke": "npm run build && node scripts/benchmark-smoke.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "@hono/node-server": "^2.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jqlts1/omnifocus-mcp-enhanced.git"
  },
  "homepage": "https://github.com/jqlts1/omnifocus-mcp-enhanced",
  "keywords": [
    "omnifocus",
    "mcp",
    "claude",
    "task-management",
    "ai",
    "subtasks",
    "enhanced",
    "productivity",
    "macos",
    "perspective",
    "perspective-api",
    "archivedfillterrules",
    "omnifocus-4.2",
    "breakthrough",
    "killer-feature"
  ],
  "author": {
    "name": "jqlts1",
    "email": "jqlts1@github.com"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "os": [
    "darwin"
  ],
  "license": "MIT"
}
